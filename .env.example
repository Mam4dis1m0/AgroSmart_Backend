# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

# ── Base de datos (Supabase → Project Settings → Database → Connection string) ──
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Seguridad / sesiones (OBLIGATORIO) ──
# Mínimo 32 caracteres. Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Duración del token en horas (opcional, por defecto 24)
JWT_EXPIRES_HOURS=24

# ── Login con Google ──
# El backend VERIFICA el ID token contra Google. Usa el mismo Client ID que el frontend/app móvil.
GOOGLE_CLIENT_ID=

# ── Pagos (suscripción Premium por transferencia Nequi) ──
# El usuario transfiere a esta cuenta Nequi y envía la referencia + foto del comprobante.
NEQUI_NUMERO=
NEQUI_TITULAR=AgroSmart
# Correos (separados por coma) que pueden aprobar o rechazar las transferencias desde la app.
PAGOS_REVISORES=
# Pago de prueba sin cobro: permitido fuera de producción. En producción (NODE_ENV=production)
# solo si declaras PAGOS_SIMULADOS=true (para demostraciones).
# PAGOS_SIMULADOS=true

# ── Marketplace ──
# Minutos que tarda en aparecer en el catálogo una oferta de un vendedor Freemium
# (Premium publica de inmediato). Por defecto 60. Para una demostración: 2. Con 0 no hay espera.
MARKETPLACE_ESPERA_FREEMIUM_MIN=60

# ── CORS (frontend web desplegado) ──
FRONTEND_URL=

# ── Servicios externos ──
GROQ_API_KEY=
MAIL_USER=
MAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
