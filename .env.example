# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

# ── Base de datos (Supabase → Project Settings → Database → Connection string) ──
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Seguridad / sesiones (OBLIGATORIO) ──
# Mínimo 32 caracteres. Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Duración del token en horas (opcional, por defecto 24)
JWT_EXPIRES_HOURS=24

# ── Login con Google ──
# El backend VERIFICA el ID token contra Google. Usa el mismo Client ID que el frontend/app móvil.
GOOGLE_CLIENT_ID=

# ── Pagos (suscripciones Premium, listado destacado) ──
# La pasarela está SIMULADA. En producción (NODE_ENV=production) se niega a cobrar salvo que
# declares PAGOS_SIMULADOS=true. Integra un proveedor real antes de cobrar de verdad (RNF-18).
# PAGOS_SIMULADOS=true

# ── CORS (frontend web desplegado) ──
FRONTEND_URL=

# ── Servicios externos ──
GROQ_API_KEY=
MAIL_USER=
MAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
